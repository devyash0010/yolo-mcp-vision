# ==========================================
# YOLO + MCP Vision Platform Configuration
# ==========================================

# Application Settings
APP_NAME="YOLO + MCP Computer Vision Platform"
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Computer Vision & YOLO Model
MODEL_PATH=models/yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.45
YOLO_IMAGE_SIZE=640
DEVICE=auto                     # Options: auto, cpu, cuda
ENABLE_TRACKING=true
TRACKER_TYPE=bytetrack.yaml

# Database Configuration (SQLite default; PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./yolo_vision.db
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional Redis Cache
# REDIS_URL=redis://localhost:6379/0
# REDIS_CACHE_TTL=300

# MCP (Model Context Protocol) Server
MCP_SERVER_NAME=yolo-vision
MCP_SERVER_VERSION=1.0.0

# LLM Agent Provider (Options: none, openai, ollama)
LLM_PROVIDER=none
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Decision Models (Jev / Clef / Clef-flash / Laya / local)
# Structured scene questions -> answers + confidence; low confidence escalates.
DECISION_PROVIDER=local          # Options: none, local, jev, clef, clef-flash, laya
DECISION_CONFIDENCE_CUTOFF=0.75  # answers below this are flagged for review
# DECISION_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<acct>/ai/run/@cf/cloudflare/clef
# DECISION_API_KEY=your_decision_api_key
# DECISION_MODEL=@cf/cloudflare/clef
# DECISION_TIMEOUT_SECONDS=5.0

# Security & Uploads
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","*"]

# Observability & Logging
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
ENABLE_METRICS=true
